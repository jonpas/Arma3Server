ARMA_BINARY=./arma3server_x64
ARMA_CDLC=""
ARMA_CONFIG=main.cfg
NETWORK_CONFIG=basic.cfg
ARMA_LIMITFPS=100
ARMA_PARAMS="-loadMissionToMemory -bandwidthAlg=2"
ARMA_PROFILE=main
ARMA_WORLD=empty
HEADLESS_CLIENTS=1
HEADLESS_CLIENTS_PROFILE="\$profile-hc-\$i" # valid placeholders: $profile, $i, $ii
MODS_LOCAL="false"
PORT=2302 # change me!
STEAM_USER=changeme
STEAM_PASSWORD=changeme
ANONYMOUS_LOGIN="false" # skip STEAM_USER/PASSWORD, log in anonymously (base server only -- no CDLC/workshop access)
MODS_PRESET="/arma3/presets/change_me.html" # rename to the name of the HTML in your ./mod_presets directory
VERIFY_PRESET="false" # update/verify mods
CDLC_FORCE="false" # force CDLC ownership instead of just compatibility data
INIT_MISSION="" # mission PBO name (e.g. "my_mission.Altis"), auto-starts it on server launch